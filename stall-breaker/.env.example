# Claude (required for real AI replies; without it the app uses canned demo replies)
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
CLAUDE_MODEL=

# Supabase (without these the app runs in local mode: no login, ledger saved in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
